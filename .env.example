# Shabd.Craft Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key (required for live mode)
OPENAI_API_KEY=your_openai_api_key_here

# Default model (optional, defaults to gpt-3.5-turbo)
SHABDCRAFT_DEFAULT_MODEL=gpt-3.5-turbo

# Demo mode (set to "true" to force demo mode even if API key is present)
SHABDCRAFT_DEMO_MODE=false

# Database path (optional, defaults to data/shabdcraft.db)
SHABDCRAFT_DB_PATH=data/shabdcraft.db

# Maximum test cases per experiment
SHABDCRAFT_MAX_TEST_CASES=50

# Maximum optimization rounds
SHABDCRAFT_MAX_OPTIMIZATION_ROUNDS=5

# Maximum retry attempts for API calls
SHABDCRAFT_MAX_RETRIES=3

# Request timeout in seconds
SHABDCRAFT_TIMEOUT=60
